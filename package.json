{
  "name": "personal-knowledge-base",
  "version": "1.0.0",
  "description": "Local-first Markdown knowledge base with a React UI, Node API, and SQLite storage.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx/esm --watch server/index.ts --dev",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.*",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "kb": "node --env-file-if-exists=.env scripts/kb.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx/esm scripts/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/restore.mjs"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "sqlite",
    "local-first"
  ],
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2"
  }
}
