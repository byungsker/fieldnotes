# The server binds to loopback by default. Keep it local during the MVP phase.
KB_HOST=127.0.0.1
KB_DATA_DIR=./data

# Leave KB_PORT unset to use 4178 for the development API and 4177 for the
# production API. Vite's development server proxies /api to this local API port.
KB_API_ORIGIN=http://127.0.0.1:4178
VITE_PORT=4177

# Optional for scripts/kb.mjs; defaults to http://127.0.0.1:4177.
# Set this to your API origin if you change the local ports.
# KB_BASE_URL=http://127.0.0.1:4177
# Optional short-lived bearer token for a reviewed private HTTPS identity proxy.
# The local Fieldnotes API does not validate this token itself.
# KB_AUTH_TOKEN=

# Leave empty for local use. Only set to an exact HTTPS origin after a private
# identity-aware proxy has been configured and tested.
KB_PUBLIC_ORIGIN=
