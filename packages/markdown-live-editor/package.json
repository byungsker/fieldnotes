{
  "name": "markdown-live-editor",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test *.test.ts"
